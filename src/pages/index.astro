---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CredibilityStrip from '../components/CredibilityStrip.astro';
import ServiceCard from '../components/ServiceCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProcessSection from '../components/ProcessSection.astro';
import { services } from '../data/services';
import { getCollection } from 'astro:content';

const homeServices = services.map((s) => ({
  title: s.title,
  description: s.summary.split('.')[0] + '.',
  icon: s.icon,
  href: `/services/${s.slug}/`,
}));

const isProd = import.meta.env.PROD;
const latestPosts = (await getCollection('blog', ({ data }) => !isProd || !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title="002 Solutions">
  <Hero />
  <CredibilityStrip />

  <section class="reveal container-site py-20 sm:py-28">
    <SectionHeading
      eyebrow="// 01 — SERVICES"
      title="What I help with."
      subtitle="Senior-level technology help, sized to fit small businesses and founders."
    />
    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-5">
      {homeServices.map((s) => (
        <ServiceCard title={s.title} description={s.description} icon={s.icon} href={s.href} />
      ))}
    </div>
  </section>

  <ProcessSection />

  <section class="reveal container-site py-20 sm:py-28 border-t hairline">
    <SectionHeading eyebrow="// 03 — ABOUT" title="Who you'd be working with." />
    <div class="mt-8 max-w-3xl text-lg text-fog-2 leading-relaxed space-y-4">
      <p>
        I'm Michael Carl — an independent technologist in Tampa, Florida, shipping iOS apps, AI tools, and backup infrastructure for small businesses and founders.
      </p>
      <p>
        <a href="/about/" class="text-brand-yellow hover:underline">Read more about how I work →</a>
      </p>
    </div>
  </section>

  <section class="reveal container-site py-20 sm:py-28 border-t hairline">
    <div class="flex items-baseline justify-between">
      <SectionHeading eyebrow="// 04 — WRITING" title="Latest writing." />
      <a href="/blog/" class="hidden sm:inline font-mono text-xs uppercase tracking-widest text-brand-yellow hover:underline flex-shrink-0">
        View all →
      </a>
    </div>
    <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-5">
      {latestPosts.map((post) => (
        <a
          href={`/blog/${post.slug}/`}
          class="group flex flex-col rounded-lg border hairline bg-ink-2/40 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-white/25 hover:bg-ink-2/70"
        >
          <time
            datetime={post.data.pubDate.toISOString()}
            class="font-mono text-xs uppercase tracking-widest text-fog-2"
          >
            {dateFmt.format(post.data.pubDate)}
          </time>
          <h3 class="mt-3 text-lg font-semibold group-hover:text-brand-yellow transition">
            {post.data.title}
          </h3>
          <p class="mt-2 text-sm text-fog-2 leading-relaxed line-clamp-3">{post.data.description}</p>
          <span class="mt-auto pt-4 inline-flex items-center gap-1 font-mono text-xs uppercase tracking-widest text-brand-yellow group-hover:gap-2 transition-all">
            Read post <span aria-hidden="true">→</span>
          </span>
        </a>
      ))}
    </div>
    <a href="/blog/" class="sm:hidden mt-8 inline-block font-mono text-xs uppercase tracking-widest text-brand-yellow hover:underline">
      View all writing →
    </a>
  </section>

  <section class="reveal container-site py-20 sm:py-28 border-t hairline">
    <div class="relative overflow-hidden rounded-xl border hairline bg-ink-2/40 p-10 sm:p-14">
      <div class="absolute -bottom-24 -right-24 w-[360px] h-[360px] rounded-full blur-3xl opacity-20 bg-brand-gradient pointer-events-none" aria-hidden="true"></div>
      <p class="eyebrow mb-4">// GET IN TOUCH</p>
      <h2 class="text-3xl sm:text-4xl font-bold max-w-2xl">
        Have something in mind? Let's talk.
      </h2>
      <div class="mt-8">
        <a href="/contact/" class="btn-primary">
          Start a conversation
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
